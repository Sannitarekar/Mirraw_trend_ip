# ------------------------------------------------------------------
# Trend Intelligence Platform - environment configuration
# Copy to .env and fill in real values. NEVER commit real secrets.
# ------------------------------------------------------------------

# --- Runtime ------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Database -----------------------------------------------------
# Use a real PostgreSQL connection string for production/CI:
#   DATABASE_URL=postgres://user:pass@localhost:5432/trends
# Leave blank (or use pglite://) for the zero-install local demo.
DATABASE_URL=
# Directory used by the embedded PGlite demo database.
PGLITE_DATA_DIR=.data/pglite

# --- Object storage -----------------------------------------------
# local  -> local filesystem mock (default, zero-setup demo)
# minio  -> S3-compatible MinIO (see docker-compose.yml)
# s3     -> real AWS S3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
# S3 / MinIO settings (used when STORAGE_DRIVER is minio or s3)
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=mirraw-trend-images
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
# Public/CDN base URL used to build image URLs returned by the API.
# For the local demo the API serves stored images itself:
CDN_BASE_URL=http://localhost:3000/files

# --- Vision AI ----------------------------------------------------
# mock   -> deterministic mock provider (default, no API key needed)
# claude -> real Claude Vision (claude-sonnet-4)
VISION_PROVIDER=mock
VISION_MODEL=claude-sonnet-4
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Pinterest ----------------------------------------------------
# mock   -> mock provider with seeded pins (default)
# api    -> real Pinterest API v5 (needs OAuth tokens)
PINTEREST_PROVIDER=mock
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_RATE_LIMIT_PER_SEC=10

# --- Slack --------------------------------------------------------
# mock -> logs the summary locally (default)
# webhook -> real Slack Incoming Webhook URL
SLACK_MODE=mock
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#product-ai

# --- Scraping ------------------------------------------------------
# fixture -> reads local HTML files in sample-data/html (default, no network)
# live    -> opens the real fashion sites in headless Chromium
SCRAPER_MODE=fixture

# --- Scoring ------------------------------------------------------
TREND_SCORE_DISCARD_THRESHOLD=20
TREND_FEED_PROMOTE_LIMIT=200
SAVE_COUNT_REFERENCE_MAX=5000
RECENCY_WINDOW_DAYS=7
SOURCE_AUTHORITY_VOGUE_FDCI=1.0
SOURCE_AUTHORITY_PINTEREST=0.8
SOURCE_AUTHORITY_SCRAPER=0.5

# --- Deduplication --------------------------------------------------
# Maximum pHash hamming distance below which two images are
# considered near-duplicates (0 = exact duplicates only).
DEDUP_PHASH_DISTANCE_THRESHOLD=10

# --- Usage restriction ---------------------------------------------
MAX_USES_PER_IMAGE_PER_MONTH=3